{
  "manifest_version": 3,
  "name": "LeadScout — Bulk LinkedIn Decision-Maker Finder",
  "version": "1.4.0",
  "description": "Research 50–100 companies in bulk (LinkedIn URLs or names) and export verified decision-makers to Excel-ready TSV/CSV. Current roles only. Optional free AI key (Groq/Gemini) and Hunter.io key for real emails. Bing-powered.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://*.linkedin.com/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.hunter.io/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeadScout — bulk decision-maker research",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
